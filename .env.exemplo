# Copie para .env e troque as senhas. Nada aqui vai para o repositório com valor de verdade.
PG_SENHA=troque-esta-senha
KC_ADMIN_SENHA=troque-esta-tambem
# endereço do Prumo ID que aparece no token (iss); o mesmo para quem está dentro e fora da rede
PRUMO_ID_URL=http://localhost:8180
# segredos dos clientes de serviço, criados no Prumo ID (capítulo 9)
PARCELAMENTOS_SEGREDO=
# modelo e janela (capítulo 3)
BROKER_MODELO=qwen3:14b
NUM_CTX=16384
VAGAS=2
# feriados municipais e estaduais (capítulo 14): MM-DD vale todo ano
FERIADOS_EXTRAS=07-09
MEM_APP_SENHA=troque-esta-senha        # papel da memória, sem poderes de dono (cap. 10)
